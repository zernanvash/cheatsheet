CH_VAULT_ROOT=/srv/ch-vault
CH_VAULT_DB=/var/lib/ch-vault/security.db
CH_VAULT_PASSPHRASE_HASH=$argon2id$REPLACE_WITH_GENERATED_HASH
CH_VAULT_COOKIE_NAME=__Host-ch_vault_session
CH_VAULT_SESSION_SECONDS=600
CH_VAULT_ORIGIN=https://ch.zernanvash.dev
CH_VAULT_TRUST_PROXY=true
CH_VAULT_CIPHER_API=http://127.0.0.1:8787
CH_VAULT_ZEN_NOTES_API=http://127.0.0.1:8788
CH_VAULT_FILESHARE_API=http://127.0.0.1:8789

